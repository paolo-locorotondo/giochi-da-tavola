{
  "name": "giochi-da-tavola",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @gdt/web --filter @gdt/server dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm test:unit && pnpm test:e2e",
    "test:unit": "pnpm -r test",
    "test:e2e": "pnpm --filter @gdt/web test:e2e",
    "test:e2e:aggiorna": "pnpm --filter @gdt/web test:e2e:aggiorna",
    "coverage": "vitest run --coverage --config vitest.coverage.config.ts"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "2.1.9",
    "typescript": "~5.6.3",
    "vitest": "2.1.9"
  }
}
